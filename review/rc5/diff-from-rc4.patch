+            if node.level:
+                continue
+            module = node.module or ""
+            if module:
+                names.append(module)
+            for alias in node.names:
+                if alias.name == "*":
+                    continue
+                names.append(f"{module}.{alias.name}" if module else alias.name)
+    return names
+
+
+def _import_is_banned(name):
+    for banned in IMPORT_BANNED:
+        if name == banned or name.startswith(banned + "."):
+            return banned
+    return None
+
